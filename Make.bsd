CPPFLAGS+=`pkg-config --cflags x11 xft` -D_DEFAULT_SOURCE -I/usr/local/include/Xorg -I/usr/local/include/freetype2 -I/usr/local/lib -I/usr/include/freetype2 -I/usr/X11R6/include -I/usr/include/X11
LDFLAGS+=-L/usr/local/include/freetype2 -L/usr/local/include -L/usr/local/lib -L/usr/X11R6/lib
LDLIBS+=`pkg-config --libs x11 xft` -lXrender -largp -lX11 -lXft -lfontconfig
CFLAGS+=-g2 -Wall -Wextra -O2 -std=c99 -pipe -pedantic -Wundef -Wshadow -W -Wwrite-strings -Wcast-align -Wstrict-overflow=5 -Wconversion -Wpointer-arith -Wstrict-prototypes -Wformat=2 -Wsign-compare -Wendif-labels -Wredundant-decls -Winit-self
PACKAGE=doomy
PROG=main.c

all:
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $(PACKAGE) $(PROG) $(LDFLAGS) $(LDLIBS)

install: 
	install -D -s -m 755 $(PACKAGE) /usr/bin/$(PACKAGE)

check: all
	sh tests/smoke.sh ./$(PACKAGE)

clean:
	rm -f $(PACKAGE)

uninstall:
	rm -f /usr/bin/$(PACKAGE)

.PHONY: all install check clean uninstall
